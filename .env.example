# App
NODE_ENV=development
APP_URL=http://localhost:3000
# Use "true" only behind HTTPS in production
COOKIE_SECURE=false

# Database
DATABASE_URL=postgresql://energon:energon@localhost:5432/energon_sentinel?schema=public

# Redis (worker / queues)
REDIS_URL=redis://localhost:6379

# Session signing (min 32 chars)
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Envelope encryption master key: 32 bytes base64
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=

# Optional: comma-separated IPs allowed to access the panel (empty = allow all)
ALLOWED_IPS=

# Seed owner (used by prisma seed)
SEED_OWNER_EMAIL=owner@energon.local
SEED_OWNER_PASSWORD=ChangeMeOwner123!
SEED_OWNER_NAME=Dono Energon

# Email — Resend (preferred)
RESEND_API_KEY=
EMAIL_FROM=Energon Sentinel <sentinel@energon.local>

# Email — SMTP fallback (used when RESEND_API_KEY is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Monitoring
CHECK_RETENTION_DAYS=30
INCIDENT_REMINDER_HOURS=4
