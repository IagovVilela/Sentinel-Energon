generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  owner
  admin
  viewer
}

enum Environment {
  production
  staging
}

enum ProjectStatus {
  operational
  degraded
  down
  unknown
}

enum ServiceCategory {
  frontend
  backend
  database
  payment
  email
  meta
  whatsapp
  hosting
  domain
  storage
  other
}

enum CredentialType {
  login
  api_key
  token
  secret
  connection_string
  other
}

enum HealthCheckType {
  http
  tcp
  ssl_expiry
  domain_expiry
  db_ping
}

enum CheckResultStatus {
  ok
  fail
}

enum IncidentStatus {
  open
  resolved
}

enum AuditAction {
  view
  copy
  create
  update
  delete
  export
  import
  reveal
}

enum PersonalAssetKind {
  photo
  resume
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  name             String?
  role             UserRole  @default(viewer)
  totpSecret       String?
  totpEnabled      Boolean   @default(false)
  failedLogins     Int       @default(0)
  lockedUntil      DateTime?
  reauthAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  sessions         Session[]
  auditLogs        AuditLog[]
  alertRules       AlertRule[]
  personalProfile  PersonalProfile?
  personalLinks    PersonalLink[]
  personalSnippets PersonalSnippet[]
  personalAssets   PersonalAsset[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  ip        String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  environment Environment   @default(production)
  status      ProjectStatus @default(unknown)
  publicUrl   String?
  logoUrl     String?
  tags        String[]      @default([])
  statusPageEnabled Boolean @default(false)
  statusPageSlug    String? @unique
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  services    Service[]
  incidents   Incident[]
  maintenanceWindows MaintenanceWindow[]
}

model Service {
  id            String          @id @default(cuid())
  projectId     String
  name          String
  category      ServiceCategory
  provider      String?
  adminUrl      String?
  hostingUrl    String?
  gitUrl        String?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  credentials   Credential[]
  healthChecks  HealthCheck[]
  incidents     Incident[]

  @@index([projectId])
  @@index([category])
}

model Credential {
  id               String         @id @default(cuid())
  serviceId        String
  type             CredentialType
  label            String
  username         String?
  ciphertext       String
  dekEncrypted     String
  iv               String
  authTag          String
  expiresAt        DateTime?
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  expiryNotified30 Boolean        @default(false)
  expiryNotified7  Boolean        @default(false)
  expiryNotified1  Boolean        @default(false)
  service          Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  auditLogs        AuditLog[]

  @@index([serviceId])
  @@index([expiresAt])
}

model HealthCheck {
  id                 String          @id @default(cuid())
  serviceId          String
  name               String
  type               HealthCheckType
  url                String?
  host               String?
  port               Int?
  method             String          @default("GET")
  headersJson        String?
  expectedStatus     Int             @default(200)
  expectedBody       String?
  timeoutMs          Int             @default(10000)
  intervalSec        Int             @default(60)
  failureThreshold   Int             @default(2)
  consecutiveFails   Int             @default(0)
  lastStatus         CheckResultStatus?
  lastCheckedAt      DateTime?
  lastLatencyMs      Int?
  enabled            Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  service            Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  results            CheckResult[]
  incidents          Incident[]

  @@index([serviceId])
  @@index([enabled])
}

model CheckResult {
  id            String            @id @default(cuid())
  healthCheckId String
  status        CheckResultStatus
  httpStatus    Int?
  latencyMs     Int?
  errorMessage  String?
  checkedAt     DateTime          @default(now())
  healthCheck   HealthCheck       @relation(fields: [healthCheckId], references: [id], onDelete: Cascade)

  @@index([healthCheckId, checkedAt])
  @@index([checkedAt])
}

model CheckResultDaily {
  id            String   @id @default(cuid())
  healthCheckId String
  day           DateTime
  okCount       Int      @default(0)
  failCount     Int      @default(0)
  avgLatencyMs  Float?
  uptimePct     Float?

  @@unique([healthCheckId, day])
  @@index([day])
}

model Incident {
  id            String         @id @default(cuid())
  projectId     String
  serviceId     String
  healthCheckId String?
  status        IncidentStatus @default(open)
  cause         String?
  startedAt     DateTime       @default(now())
  endedAt       DateTime?
  durationMs    Int?
  lastNotifiedAt DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service       Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  healthCheck   HealthCheck?   @relation(fields: [healthCheckId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([serviceId])
  @@index([status])
}

model MaintenanceWindow {
  id        String   @id @default(cuid())
  projectId String
  title     String
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, startsAt, endsAt])
}

model AlertRule {
  id              String   @id @default(cuid())
  userId          String?
  email           String
  notifyDown      Boolean  @default(true)
  notifyRecovery  Boolean  @default(true)
  notifyExpiry    Boolean  @default(true)
  reminderHours   Int      @default(4)
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  notifications   NotificationLog[]
}

model NotificationLog {
  id          String   @id @default(cuid())
  alertRuleId String?
  channel     String   @default("email")
  eventType   String
  recipient   String
  subject     String
  bodyPreview String?
  success     Boolean
  error       String?
  metadata    String?
  sentAt      DateTime @default(now())
  alertRule   AlertRule? @relation(fields: [alertRuleId], references: [id], onDelete: SetNull)

  @@index([sentAt])
  @@index([eventType])
}

model AuditLog {
  id           String      @id @default(cuid())
  userId       String?
  credentialId String?
  action       AuditAction
  ip           String?
  userAgent    String?
  detail       String?
  createdAt    DateTime    @default(now())
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  credential   Credential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([credentialId])
  @@index([createdAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

model PersonalProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  fullName     String
  email        String
  linkedinUrl  String?
  companyUrl   String?
  headline     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PersonalLink {
  id        String   @id @default(cuid())
  userId    String
  label     String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sortOrder])
}

model PersonalSnippet {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sortOrder])
}

model PersonalAsset {
  id        String            @id @default(cuid())
  userId    String
  kind      PersonalAssetKind
  filename  String
  mimeType  String
  data      Bytes
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@index([userId])
}
